{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "UV_PYTHON": "3.12"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(~/src/**)",
      "Read(~/logs/**)",
      "Read(~/pc-setup/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git clone *)",
      "Bash(git remote *)",
      "Bash(git submodule *)",
      "Bash(git lfs *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(telnet *)",
      "Bash(ftp *)",
      "Bash(gh *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv pip install *)",
      "Bash(uv add *)",
      "Bash(uv tool *)",
      "Bash(uvx *)",
      "Bash(pipx *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(dotnet tool *)",
      "Bash(dotnet add *)",
      "Bash(sh -c *)",
      "Bash(bash -c *)",
      "Bash(zsh -c *)",
      "Bash(claude *)",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive --force *)",
      "Bash(rm --force --recursive *)",
      "Bash(rm -r /)",
      "Bash(rm -r /*)",
      "Bash(rm -R /*)",
      "Bash(rm --recursive /*)",
      "Bash(rm -r ~)",
      "Bash(rm -r ~*)",
      "Bash(rm -R ~*)",
      "Bash(rm --recursive ~*)",
      "Bash(rm -r $HOME*)",
      "Bash(rm -R $HOME*)",
      "Bash(rm -r \"$HOME*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm *)",
      "Bash(shred *)",
      "Bash(mkfs*)",
      "Bash(dd *of=/dev/*)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",

      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(dash)",
      "Bash(sh -)",
      "Bash(bash -)",
      "Bash(sh -s*)",
      "Bash(bash -s*)",
      "Bash(sh /dev/stdin*)",
      "Bash(bash /dev/stdin*)",
      "Bash(sh <(*)",
      "Bash(bash <(*)",
      "Bash(source <(*)",
      "Bash(. <(*)",
      "Bash(source /dev/stdin*)",
      "Bash(. /dev/stdin*)",
      "Bash(eval *)",
      "Bash(python -)",
      "Bash(python3 -)",

      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(pkexec *)",
      "Bash(runuser *)",

      "Bash(chmod *777*)",
      "Bash(chmod *a+rwx*)",
      "Bash(chmod *ugo+rwx*)",

      "Read(~/.ssh)",
      "Read(~/.ssh/**)",
      "Read(~/.aws)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.local/state/spireline-rc/**)",
      "Read(//mnt/c/Users/**)",

      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_logout)",
      "Edit(~/.config/systemd/**)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/pc-setup/**)",
      "Edit(~/.local/bin/**)",
      "Edit(~/.local/share/uv/**)",
      "Edit(~/.dotnet/**)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",

      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(*.exe)",
      "Bash(*.exe *)",
      "Bash(tmux *)",
      "Bash(screen *)",
      "Bash(systemd-run *)",
      "Bash(systemctl *)",
      "Bash(crontab *)",
      "Bash(at *)",

      "mcp__*"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/code",
        "~/src",
        "~/logs",
        "~/.venvs/spireline"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.netrc",
        "~/.claude/.credentials.json",
        "~/.local/state/spireline-rc",
        "/mnt/c/Users"
      ]
    },
    "network": {
      "allowAllUnixSockets": false
    }
  }
}
